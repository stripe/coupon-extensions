{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "customConditions": ["extensibility"],
    "rootDir": ".",
    "plugins": [
      {
        "name": "@stripe/extensibility-language-server/plugin"
      }
    ]
  },
  "include": [
    "src/**/*.ts",
    "node_modules/@stripe/extensibility-sdk/tslibs/lib.restricted.globals.d.ts"
  ],
  "exclude": ["dist"]
}
